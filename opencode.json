{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git push*": "ask",
      "python -m *": "allow",
      "py -3.11 -m *": "allow",
      "pip install*": "allow",
      "ruff *": "allow",
      "pytest*": "allow"
    }
  }
}